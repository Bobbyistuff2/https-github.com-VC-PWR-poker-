{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pwr-poker-server.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://pwr-poker-server.onrender.com/auth/:path*" },
    { "source": "/socket.io", "destination": "https://pwr-poker-server.onrender.com/socket.io" },
    { "source": "/socket.io/(.*)", "destination": "https://pwr-poker-server.onrender.com/socket.io/$1" },
    { "source": "/((?!.*\\..*).*)", "destination": "/index.html" }
  ]
}
