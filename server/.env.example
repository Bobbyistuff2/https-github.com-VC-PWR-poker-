# IMPORTANT (production only): the *_REDIRECT_URI values must point at the
# CLIENT_URL domain (the Vercel frontend), not the Render backend domain,
# even though the callback route itself lives on the backend. Vercel proxies
# /auth/:path* through to Render (see client/vercel.json), so as long as the
# OAuth provider redirects back to the Vercel domain, that hop is proxied
# server-side and the session cookie ends up scoped to the domain the
# frontend actually talks to. Point the redirect straight at the Render
# domain instead and the callback still succeeds, but the cookie it sets
# never reaches the frontend's later /api/me calls (they go through the
# Vercel proxy, which the browser sees as a different origin than
# onrender.com) — every login silently bounces back to signed-out. Learned
# this the hard way wiring up Google sign-in; goes for Discord too.
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SESSION_SECRET=change-this-to-a-random-string
CLIENT_URL=http://localhost:5173
PORT=3000

# Only needed in production (Render) — see litestream.yml and render.yaml.
# Not needed for local dev; leave unset and the app runs exactly as before.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
